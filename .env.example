# Fake placeholders only. Never commit real credentials.
# Cloudflare CLI variables (optional; deploy from a CI runner with these set in the platform).
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token

# Runtime secrets — set with `wrangler secret put <NAME>`, not by committing a .env file.
# Generate each with: openssl rand -hex 32
VEYRO_SESSION_SECRET=replace-with-random-32-byte-hex
VEYRO_PROVIDER_SECRET=replace-with-random-32-byte-hex
